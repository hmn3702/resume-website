# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Supabase - find these in your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL - used for canonical URLs, OG tags, sitemap, robots.txt
# Local dev: http://localhost:3000 | Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email notifications (server-only - NEVER prefix with NEXT_PUBLIC_)
# Resend dashboard → API Keys. Mark as "Secret"/"Sensitive" in Vercel.
RESEND_API_KEY=re_your_key_here
# Where new-message alerts are sent. Without a verified domain in Resend,
# this must be the email address you signed up to Resend with.
CONTACT_NOTIFY_EMAIL=you@example.com
# Optional sender; defaults to Resend's test sender
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
